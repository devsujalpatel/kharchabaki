{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "src": {
      "root": "services"
    }
  },
  "rewrites": [
    {
      "source": "/api/src(/.*)?",
      "destination": {
        "type": "service",
        "service": "src"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
