{
  "expo": {
    "name": "Kharchabaki",
    "slug": "kharchabaki-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.kharchabakinative"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#071A12"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.kharchabakinative",
      "softwareKeyboardLayoutMode": "resize"
    },
    "scheme": "kharchabaki",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#090b09",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#090b09"
          }
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b06dd55d-1615-4080-9669-07fe0e1f75ac"
      }
    }
  }
}
